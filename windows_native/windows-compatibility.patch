+++ b/src/core/interfaces/gnss_sdr_time_parse.h
@@ -0,0 +1,27 @@
+#ifndef GNSS_SDR_TIME_PARSE_H
+#define GNSS_SDR_TIME_PARSE_H
+#include <ctime>
+#include <cstring>
+#include <iomanip>
+#include <sstream>
+inline char* gnss_sdr_strptime(const char* text, const char* format, std::tm* value)
+{
+#ifdef _WIN32
+    std::istringstream input(text);
+    input >> std::get_time(value, format);
+    if (input.fail()) return nullptr;
+    const auto consumed = input.tellg();
+    return const_cast<char*>(text + (consumed < 0 ? std::strlen(text) : static_cast<std::size_t>(consumed)));
+#else
+    return strptime(text, format, value);
+#endif
+}
+inline std::time_t gnss_sdr_timegm(std::tm* value)
+{
+#ifdef _WIN32
+    return _mkgmtime(value);
+#else
+    return timegm(value);
+#endif
+}
+#endif
