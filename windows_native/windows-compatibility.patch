+#ifndef GNSS_SDR_WINDOWS_NETWORK_H
+#define GNSS_SDR_WINDOWS_NETWORK_H
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#include <errno.h>
+// Winsock is held for the process lifetime; no cleanup while worker threads run.
+static BOOL CALLBACK gnss_wsa_init(PINIT_ONCE once, PVOID parameter, PVOID *context)
+{
+    WSADATA data;
+    (void)once; (void)parameter; (void)context;
+    return WSAStartup(MAKEWORD(2, 2), &data) == 0;
+}
+static inline int gnss_wsa_startup(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    return InitOnceExecuteOnce(&once, gnss_wsa_init, NULL, NULL) ? 0 : -1;
+}
+#ifdef __cplusplus
+inline const int gnss_wsa_process_init = gnss_wsa_startup();
+#endif
+#endif
+#endif
