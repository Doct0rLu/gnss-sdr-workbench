+void Gnss_Sdr_Valve::forecast(int noutput_items, gr_vector_int& ninput_items_required)
+{
+    // The terminal work call posts STOP and consumes no input. At physical EOF
+    // the scheduler has no further input item with which to schedule that call.
+    if (d_stop_flowgraph && !d_open_valve && d_ncopied_items == d_nitems)
+        {
+            std::fill(ninput_items_required.begin(), ninput_items_required.end(), 0);
+            return;
+        }
+    gr::sync_block::forecast(noutput_items, ninput_items_required);
+}
